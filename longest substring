
class Solution(object):
    def longestSubstring(self, s, k):
        """
        :type s: str
        :type k: int
        :rtype: int
        """
        n = len(s)

        if k <= 1:
            return n

        if n < k:
            return 0

        max_len = 0

        for unique_target in range(1, 27):
            freq = {}
            left = 0
            right = 0
            unique_count = 0
            count_at_least_k = 0

            while right < n:
                char = s[right]
                freq[char] = freq.get(char, 0) + 1

                if freq[char] == 1:
                    unique_count += 1

                if freq[char] == k:
                    count_at_least_k += 1

                right += 1

                while unique_count > unique_target:
                    left_char = s[left]

                    if freq[left_char] == k:
                        count_at_least_k -= 1

                    freq[left_char] -= 1

                    if freq[left_char] == 0:
                        unique_count -= 1

                    left += 1

                if unique_count == unique_target and unique_count == count_at_least_k:
                    max_len = max(max_len, right - left)

        return max_len
